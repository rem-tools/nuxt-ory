{
  "name": "@rem-tools/nuxt-ory",
  "version": "1.2.7",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build --stub && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist .nuxt playground/.nuxt",
    "prepublish": "yarn run clean && yarn run dev:prepare && yarn run prepack"
  },
  "dependencies": {
    "@nuxt/kit": "3.21.7",
    "@ory/client": "^1.6.2",
    "camel-case": "^5.0.0",
    "constant-case": "^4.0.0",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.4",
    "@nuxt/eslint-config": "^0.2.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "3.21.7",
    "@nuxt/test-utils": "3.21.0",
    "@ory/cli": "^0.3.4",
    "@types/node": "^20.11.20",
    "changelogen": "^0.5.5",
    "eslint": "^8.57.0",
    "nuxt": "3.21.7",
    "vitest": "3.2.6",
    "@nuxt/cli": "3.37.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6"
  },
  "resolutions": {
    "@nuxt/devtools": "3.4.4",
    "@nuxt/test-utils": "3.21.0",
    "vitest": "3.2.6",
    "tinypool": "2.1.2",
    "tar": "7.5.22",
    "shell-quote": "1.11.0"
  }
}
